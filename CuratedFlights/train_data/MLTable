paths:
- file: bts_results.csv
transformations:
- read_delimited:
    delimiter: ','
    empty_as_string: false
    encoding: utf8
    header: from_first_file
    include_path_column: false
    infer_column_types: true
    partition_size: 20971520
    path_column: Path
    support_multi_line: false
- keep_columns:
  - OP_CARRIER
  - DEP_TIME
  - DEP_DELAY
  - DEP_DELAY_GROUP
  - ORIGIN
  - DEST
  - DISTANCE
  - CARRIER_DELAY
  - WEATHER_DELAY
  - NAS_DELAY
  - SECURITY_DELAY
  - LATE_AIRCRAFT_DELAY
  - FLIGHT_RULES
- convert_column_types:
  - column_type: string
    columns: OP_CARRIER
  - column_type: string
    columns: DEP_TIME
  - column_type: float
    columns: DEP_DELAY
  - column_type: string
    columns: DEP_DELAY_GROUP
  - column_type: string
    columns: ORIGIN
  - column_type: string
    columns: DEST
  - column_type: float
    columns: DISTANCE
  - column_type: float
    columns: CARRIER_DELAY
  - column_type: float
    columns: WEATHER_DELAY
  - column_type: float
    columns: NAS_DELAY
  - column_type: float
    columns: SECURITY_DELAY
  - column_type: float
    columns: LATE_AIRCRAFT_DELAY
  - column_type: string
    columns: FLIGHT_RULES
type: mltable
